# Set this to your lower-case GHCR package path after publishing the image.
# Example: ghcr.io/your-github-username/slims-docker-deployment
IMAGE_NAME=ghcr.io/your-github-username/slims-docker-deployment
IMAGE_TAG=dev

HTTP_PORT=8080
APP_ENV=production

DB_NAME=senayan
DB_USER=slims_app
# Replace both values with long random secrets. Do not commit the real .env.
DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
DB_ROOT_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_SECRET
